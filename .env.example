# Local development; do not use these example credentials for a public deployment.
DATABASE_URL=postgresql://city:replace-with-local-password@127.0.0.1:5432/city
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CITY_DB_PASSWORD=replace-with-local-password
API_ORIGIN=http://127.0.0.1:3102
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional, server-side only. Without it the assistant explicitly uses local data analysis.
AI_API_KEY=
SEED_ADMIN_PASSWORD=replace-with-your-admin-password
SEED_ANALYST_PASSWORD=replace-with-your-analyst-password
SEED_USER_PASSWORD=replace-with-your-visitor-password

# Optional map integration. Use a Web JS API key with localhost in its domain allowlist.
# Vite reads VITE_* from .env; restart the development server after changing them.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
